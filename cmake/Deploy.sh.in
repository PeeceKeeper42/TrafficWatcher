#!/bin/bash
# Скрипт развёртывания Qt-приложения (сгенерирован CMake)

WINDEPLOYQT="@WINDEPLOYQT_EXECUTABLE@"
EXE_PATH="@EXE_PATH@"
QML_DIR="@QML_DIR@"
BUILD_TYPE="@CMAKE_BUILD_TYPE@"

if [ ! -f "$WINDEPLOYQT" ]; then
    echo "windeployqt не найден: $WINDEPLOYQT"
    exit 1
fi

if [ ! -f "$EXE_PATH" ]; then
    echo "Исполняемый файл не найден: $EXE_PATH"
    exit 1
fi

echo "Running windeployqt for $EXE_PATH ..."
if [ "$BUILD_TYPE" = "Debug" ]; then
    "$WINDEPLOYQT" "$EXE_PATH" --debug --qmldir "$QML_DIR"
else
    "$WINDEPLOYQT" "$EXE_PATH" --qmldir "$QML_DIR"
fi

echo "Deployment finished."